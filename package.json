{
  "name": "agent-wardrobe",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Agent Wardrobe: a free local desktop character companion for AI agents, with a transparent streaming overlay",
  "main": "main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package:mac": "node scripts/package-mac.cjs",
    "package:win": "node scripts/package-win.cjs",
    "package:linux": "node scripts/package-linux.cjs",
    "sign:setup": "node scripts/create-signing-identity.cjs",
    "build:vrm": "esbuild vendor-src/vrm-kit.js --bundle --minify --format=iife --legal-comments=eof --outfile=vendor/vrm-kit.js",
    "smoke": "node scripts/run-smokes.cjs",
    "check": "npm test && npm run smoke",
    "laya:setup": "node scripts/setup-laya.cjs",
    "build:live2d": "esbuild vendor-src/live2d-kit.js --bundle --minify --format=iife --legal-comments=eof --external:@pixi/sound --outfile=vendor/live2d-kit.js"
  },
  "devDependencies": {
    "@moeru/three-mmd": "0.2.0-beta.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "electron": "^41.10.7",
    "esbuild": "^0.28.2",
    "pixi.js": "^8.22.0",
    "resedit": "^3.1.0",
    "three": "^0.186.1",
    "untitled-pixi-live2d-engine": "^1.4.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ag-psd": "^31.0.2",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.4",
    "qrcode-generator": "^2.0.4",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.22.0"
  }
}
